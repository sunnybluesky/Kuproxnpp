  <style>
    h1,
    h2,
    h3 {
      margin-top: 1.4em;
      margin-bottom: 0.5em;
      line-height: 1.3;
    }
    h1 {
      font-size: 1.8em;
      border-bottom: 2px solid #dcdde1;
      padding-bottom: 0.2em;
    }
    h2 {
      font-size: 1.4em;
      border-bottom: 1px solid #dcdde1;
      padding-bottom: 0.2em;
    }
    p {
      margin-bottom: 1em;
    }
    ul,
    ol {
      margin-bottom: 1em;
      padding-left: 1.8em;
    }
    a {
      color: #0984e3;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    blockquote {
      border-left: 4px solid #0984e3;
      background-color: #f5f7fa;
      padding: 8px 14px;
      margin: 1em 0;
      color: #636e72;
    }
    code {
      font-family: "SFMono-Regular", Consolas, Menlo, monospace;
      background-color: #f1f2f6;
      padding: 2px 5px;
      border-radius: 3px;
      font-size: 0.9em;
    }
    pre {
      background-color: #2f3640;
      color: #f5f6fa;
      padding: 12px 16px;
      border-radius: 6px;
      overflow-x: auto;
      margin-bottom: 1em;
    }
    pre code {
      background: none;
      color: inherit;
      padding: 0;
    }
    table {
      border-collapse: collapse;
      width: 100%;
      margin-bottom: 1em;
    }
    th,
    td {
      border: 1px solid #dcdde1;
      padding: 8px 12px;
      text-align: left;
    }
    th {
      background-color: #f5f7fa;
    }
  </style>
  <section>
    <main id="content"></main>
  </section>

