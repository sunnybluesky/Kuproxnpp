---
import Header from '../layouts/Header.astro';
import Layout from '../layouts/Layout.astro';
import AccountSystem from '../layouts/AccountSystem.astro';


// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<link rel="stylesheet" href="/style/LP.css">
	<Header />


        <!-- Hero Section -->
        <div class="hero-container">
            <div class="hero">
                <!--    <img src="https://files.catbox.moe/kmgoer.png" alt="Kuproxnpp Logo">    -->

                <div class="svg-container">
                    <svg viewBox="0 0 1000 200" width="100%" height="60%"
                        preserveAspectRatio="xMidYMid meet">

                        <text class="back-title" x="50%" y="0%"
                            text-anchor="middle"
                            dominant-baseline="central"
                            font-size="100"
                            font-weight="bold"
                            fill="none"
                            stroke="#dd"
                            font-style="italic"
                            stroke-width="3">
                            404
                        </text>
                        <text class="title" x="50%" y="-20%"
                            text-anchor="middle"
                            dominant-baseline="central"
                            font-size="80"
                            font-weight="bold"
                            fill="none"
                            stroke="url(#text-gradient-20deg)"
                            font-style="italic"
                            stroke-width="3">
                            404
                        </text>
                        <text x="50%" y="20%"
                            text-anchor="middle"
                            dominant-baseline="central"
                            font-size="20"
                            fill="#333"
                            font-family="HinaMincho"
                            class="Message404">
                            お探しのページは見つかりませんでした。
                        </text>
                        <defs>
                            <!-- 20度回転させたグラデーションを定義 -->
                            <lineargradient id="text-gradient-20deg"
                                x1="0%" y1="0%" x2="100%" y2="0%"
                                gradientTransform="rotate(20)">
                                <stop offset="0%" stop-color="#221e2e" />
                                <stop offset="100%" stop-color="#361f24" />
                            </lineargradient>
                        </defs>
                    </svg>
                </div>
            </div>
        </div>
          <script type="module">
    import { check } from "astro/zod";
    import { getSecret } from "astro:env/server";

    const SPREADSHEET_ID = "192lM-4XxkDJF-TYhRFnKteMbqhgwcPyKIYnASHIl7ME";
    const API_KEY = "AIzaSyCmVA13zyYwNurVKsDCWuSczupgyy5jza4";
    async function getSheetData(RANGE = "Admin!A2:A1000") {
      const url = `https://sheets.googleapis.com/v4/spreadsheets/${SPREADSHEET_ID}/values/${RANGE}?key=${API_KEY}`;
      try {
        const response = await fetch(url);
        const data = await response.json();
        localStorage.setItem("cacheSheet", JSON.stringify(data.values));
        console.log(data.values); // 二次元配列でデータが入っています
        return data.values;
      } catch (error) {
        console.error("エラー:", error);
        return null;
      }
    }

    const requestedPath = location.pathname.split("/")[1]

    const data = await getSheetData("HiddenMessages!A2:B1000")
    const index = data[0].indexOf(requestedPath)
    console.log(index)
    if(index != -1){
        var text = data[index][1]
        document.querySelector(".Message404").innerHTML = text
    }
</script>
	<AccountSystem />
</Layout>