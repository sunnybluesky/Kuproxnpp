---
import Image from "astro/components/Image.astro";
import Menu from "../assets/menu.svg";
---

<header>
  <div class="header-logo">
    <img src="https://files.catbox.moe/kmgoer.png" alt="Kuproxnpp Logo" />
    <h1>Kuproxnpp</h1>
  </div>
  <nav>
    <div class="notLogined">
      <a href="/account/login/">ログイン</a>
    </div>
    <div class="Logined flex login-badge">
      <img class="icon" />
      <span>ようこそ、<span class="username"></span>さん</span>
    </div>
    <div class="menu">
      <img src="../../src/assets/menu.svg" class="hamburger" id="js-hamburger"/>
    </div>
  </nav>
        <nav class="nav" id="js-nav">
            <ul class="nav-list">
                <li class="nav-item"><a href="#">戻る</a></li>
                <li class="nav-item"><a href="#">ホーム</a></li>
                <li class="nav-item"><a href="/" id="btn-logout">ログアウト</a></li>
            </ul>
        </nav>
  <script>
document.addEventListener('DOMContentLoaded', () => {
    const hamburger = document.getElementById('js-hamburger');
    const nav = document.getElementById('js-nav');
    const navLinks = document.querySelectorAll('.nav-item a');

    // 1. ハンバーガーボタンクリック時の処理
    hamburger.addEventListener('click', (e) => {
        // ボタンクリック時に、documentへのイベント伝播（バブリング）が走らないようにする
        e.stopPropagation();
        hamburger.classList.toggle('active');
        nav.classList.toggle('active');
    });

    // 2. メニュー内のリンクをクリックしたときにメニューを閉じる
    navLinks.forEach(link => {
        link.addEventListener('click', () => {
            hamburger.classList.remove('active');
            nav.classList.remove('active');
        });
    });

    // 3. 【新規追加】メニュー外（ドキュメント全体）がクリックされたときの処理
    document.addEventListener('click', (e) => {
        // メニューが開いていて、かつクリックされた場所が「メニュー内」でも「ハンバーガーボタン」でもない場合
        if (nav.classList.contains('active') && !nav.contains(e.target) && !hamburger.contains(e.target)) {
            hamburger.classList.remove('active');
            nav.classList.remove('active');
        }
    });
});
</script>
</header>

<style>
  .Logined {
    display: none;
  }
  .icon {
    height: 30px;
    margin-right: 10px;
    border-radius: 10px;
    line-height: 40px;
  }
  .menu {
    height: 20px;
    width: 20px;
    line-height: 40px;
    padding-left: 20px;
  }
</style>
<style>
    /* 基本設定 */
body {
    margin: 0;
    font-family: sans-serif;
}

a {
    text-decoration: none;
    color: inherit;
}

ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

/* ヘッダー */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    height: 60px;
    background-color: #333;
    color: #fff;
    position: relative;
    z-index: 100;
}

.logo {
    font-weight: bold;
    font-size: 1.2rem;
}

/* ハンバーガーボタン */
.hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 30px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 101;
}

.hamburger span {
    display: block;
    width: 100%;
    height: 3px;
    background-color: #fff;
    transition: transform 0.3s, opacity 0.3s;
}

/* ナビゲーションメニュー（スマホ用：初期状態は画面外へ隠す） */
.nav {
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    height: 100vh;
    background-color: rgba(51, 51, 51, 0.95);
    display: flex;
    justify-content: center;
    align-items: center;
    transition: right 0.3s ease-in-out;
}

.nav-list {
    text-align: center;
}

.nav-item {
    margin: 20px 0;
}

.nav-item a {
    font-size: 1.2rem;
    color: #fff;
}

/* --- メニューオープン時のスタイル（JavaScriptで付与） --- */

/* ボタンのバツ印変形 */
.hamburger.active span:nth-child(1) {
    transform: translateY(9.5px) rotate(45deg);
}

.hamburger.active span:nth-child(2) {
    opacity: 0;
}

.hamburger.active span:nth-child(3) {
    transform: translateY(-9.5px) rotate(-45deg);
}

/* メニューの表示 */
.nav.active {
    right: 0;
}


</style>
